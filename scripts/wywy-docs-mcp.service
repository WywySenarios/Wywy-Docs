[Unit]
Description=Wywy-Docs MCP Server
Documentation=https://github.com/WywySenarios/Wywy-Docs
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=%h/.config/wywy-docs-mcp/environment
WorkingDirectory=%h
# Set PORT to a custom listening port (default: 2530 if unset)
Environment=PORT=
ExecStart=/bin/sh -c 'exec "$WYWY_DOCS_DIR/.venv/bin/python" -m wywy_docs.server'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
